# ===== 大体积 / 与采集无关目录（一律不进仓库）=====
/backups/
/raw_pages/
/external_sources/
/viz/echarts.min.js
/viz/viz_index_v1_legacy.html
/temp/
**/_merged_archive/
/incoming/agent_*.jsonl

# ===== 主库备份文件（历史快照，本地保留即可）=====
model_data_v2.jsonl.bak*
model_data_v2.jsonl.pre_*
model_data_v2.jsonl.batch4_*
model_data_v2.jsonl.*_bak

# ===== 平台 / 编辑器杂项 =====
/启动可视化.bat
# ledger 改前备份（各平台本地保留即可，不进仓库；正式备份请放 /backups/）
docs/*.bak
*.log
*.tmp
*.swp
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

# ===== 不追踪平台本地实验文件（仅 _samples/ 与 _m_context.md 入库）=====
# 平台 submit 时用 git add -f 强加自己的输出文件
/incoming/models/*.jsonl
!/incoming/models/_samples/
!/incoming/models/_m_context.md

# 整改脚本自动备份（可从 git 恢复，不入库）
model_data_v2.jsonl.d*bak-*
# 门禁脚本备份（D22 升 ERROR 前的快照，等价 model_data_v2.jsonl.d*bak-*）
scripts/*.d*bak-*

# 便携包：换机归档载体（包内是仓库已有数据 + memory/temp 的不入库副本，
# 本身不该入库 —— 与 /docs/memory/ 同理由：user/ 含个人信息）
/model_data_portable_*/

# 记忆的仓库内副本（2026-08-31 用户裁决：不入库）
# 原因：远端是 GitHub 公共仓库，而 user/ 里含用户在其他项目里的协作习惯、项目名与本机路径。
# 它只需要随本机工作区交接给新平台；日后若改主意要提交，删掉下面这一行即可。
/docs/memory/
